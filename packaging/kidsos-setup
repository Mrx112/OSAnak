#!/bin/bash
# KidsOS - ubah antiX Linux menjadi sistem operasi khusus anak (dan sebaliknya).
#
#   sudo kidsos-setup enable     aktifkan KidsOS (otomatis dijalankan saat paket dipasang)
#   sudo kidsos-setup disable    kembalikan antiX seperti semula (desktop & login biasa)
#   sudo kidsos-setup password   ganti password Mode Admin
#   sudo kidsos-setup status     tampilkan status
#
# Yang dilakukan "enable":
#   1. Membuat user khusus anak (default: anak) tanpa password & tanpa sudo.
#   2. Login otomatis user itu di tty1 (sysvinit / runit / systemd).
#   3. Mematikan display manager (slimski/slim/lightdm/...) agar tidak ada
#      layar login maupun desktop.
#   4. tty1 -> startx -> /usr/lib/kidsos/kidsos-session -> main.py --session.
#   5. Xorg: Ctrl+Alt+F1..F12 dan Ctrl+Alt+Backspace dimatikan.
#   6. sudo tanpa password khusus untuk: poweroff, reboot, kidsos-pkg.
#   7. Membuat semua suara & musik (sounds.py) sekali di /opt/kidsos/sounds.
#   8. Tema menu GRUB (bootmenu.jpg) & animasi boot (boot1.gif) di framebuffer.
#
#   sudo kidsos-setup log        diagnosa jika menu anak tidak muncul
#   sudo kidsos-setup boot       pasang ulang tema GRUB & animasi boot
#                                (mis. setelah ganti monitor/resolusi)
#
# Jalan darurat: di menu GRUB tekan "e", tambahkan  kidsos=off  di baris
# "linux", lalu Ctrl+X. tty1 akan menampilkan login teks biasa.

set -euo pipefail

CONF_DIR=/etc/kidsos
CONF=$CONF_DIR/kidsos.conf
HASH_FILE=$CONF_DIR/admin.sha256
DM_STATE=$CONF_DIR/dm-disabled
XORG_CONF=/etc/X11/xorg.conf.d/90-kidsos.conf
SUDOERS=/etc/sudoers.d/kidsos
SESSION=/usr/lib/kidsos/kidsos-session
PKG_HELPER=/usr/lib/kidsos/kidsos-pkg
BOOTANIM=/usr/lib/kidsos/kidsos-bootanim
INSTALL_DIR=/opt/kidsos
ASSETS=$INSTALL_DIR/assets/boot
GRUB_THEME_DIR=/boot/grub/themes/kidsos
BOOTANIM_INIT=/etc/init.d/kidsos-bootanim
BOOTANIM_UNIT=/etc/systemd/system/kidsos-bootanim.service
MARK_BEGIN="# >>> KidsOS >>>"
MARK_END="# <<< KidsOS <<<"
DMS="slimski slim lightdm lxdm sddm gdm3 xdm nodm"

say()  { printf '\033[1;35m[KidsOS]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[KidsOS] PERINGATAN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[KidsOS] GAGAL:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "jalankan sebagai root: sudo kidsos-setup ${1:-enable}"

# --------------------------------------------------------------- konfigurasi
guess_admin() {
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        echo "$SUDO_USER"; return
    fi
    getent passwd | awk -F: -v kid="${KID_USER:-anak}" \
        '$3 >= 1000 && $3 < 60000 && $1 != kid { print $1; exit }'
}

KID_USER=anak
ADMIN_USER=""
REPO_URL=https://github.com/Mrx112/OSAnak
REPO_BRANCH=main
RESOLUTION=640x480
[ -r "$CONF" ] && . "$CONF"
KID_USER=${KIDSOS_USER:-$KID_USER}
[ -n "$ADMIN_USER" ] || ADMIN_USER=$(guess_admin)
[ -n "$ADMIN_USER" ] || ADMIN_USER=root

save_conf() {
    mkdir -p "$CONF_DIR"
    cat > "$CONF" <<EOF
# KidsOS - dibaca oleh kidsos-setup, kidsos-session & kidsos-pkg.
KID_USER=$KID_USER
# Akun yang diminta passwordnya saat terminal darurat terbuka.
ADMIN_USER=$ADMIN_USER
# Sumber "Upgrade KidsOS" di Panel Admin.
REPO_URL=$REPO_URL
REPO_BRANCH=$REPO_BRANCH
# Resolusi layar menu anak & menu boot (WxH atau auto); diubah di Panel Admin.
RESOLUTION=$RESOLUTION
EOF
    chmod 644 "$CONF"
}

kid_home() { getent passwd "$KID_USER" | cut -d: -f6; }

init_system() {
    if [ -d /run/systemd/system ]; then echo systemd
    elif [ -f /etc/inittab ] && grep -qE '^1:[0-9]+:respawn:' /etc/inittab; then echo sysvinit
    elif [ -d /etc/sv ]; then echo runit
    else echo unknown
    fi
}

# ------------------------------------------------------------------ password
set_password() {
    if [ ! -r /dev/tty ] || ! { true </dev/tty; } 2>/dev/null; then
        warn "tidak ada terminal untuk mengetik password."
        warn "Password Mode Admin sementara: admin123 -> ganti: sudo kidsos-setup password"
        return
    fi
    local p1 p2
    while :; do
        read -rsp "Password baru Mode Admin: " p1 </dev/tty; echo >/dev/tty
        read -rsp "Ulangi password: " p2 </dev/tty; echo >/dev/tty
        if [ -z "$p1" ]; then echo "Password tidak boleh kosong." >/dev/tty
        elif [ "$p1" != "$p2" ]; then echo "Tidak sama, coba lagi." >/dev/tty
        else break
        fi
    done
    mkdir -p "$CONF_DIR"
    printf '%s' "$p1" | sha256sum | cut -d' ' -f1 > "$HASH_FILE"
    chmod 644 "$HASH_FILE"    # launcher (user anak) perlu membaca hash-nya
    say "Password Mode Admin disimpan."
}

# ------------------------------------------------------------------ enable
create_kid_user() {
    if ! id "$KID_USER" >/dev/null 2>&1; then
        say "Membuat user '$KID_USER'..."
        adduser --disabled-password --gecos "Anak" "$KID_USER" >/dev/null
    fi
    for g in audio video plugdev input netdev bluetooth; do
        if getent group "$g" >/dev/null; then usermod -aG "$g" "$KID_USER"; fi
    done
    for g in sudo wheel adm; do
        if id -nG "$KID_USER" | tr ' ' '\n' | grep -qx "$g"; then
            gpasswd -d "$KID_USER" "$g" >/dev/null
        fi
    done
}

setup_kid_home() {
    local home; home=$(kid_home)
    [ -d "$home" ] || die "home $KID_USER tidak ditemukan"

    # ~/.xinitrc -> sesi KidsOS
    if [ -f "$home/.xinitrc" ] && ! grep -q kidsos-session "$home/.xinitrc"; then
        mv "$home/.xinitrc" "$home/.xinitrc.kidsos-bak"
    fi
    printf '#!/bin/sh\n# KidsOS\nexec %s\n' "$SESSION" > "$home/.xinitrc"
    chmod 755 "$home/.xinitrc"

    # ~/.bash_profile -> startx otomatis di tty1
    local bp="$home/.bash_profile"
    [ -f "$bp" ] || printf '[ -f ~/.profile ] && . ~/.profile\n' > "$bp"
    sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" "$bp"
    cat >> "$bp" <<EOF
$MARK_BEGIN
# Nyalakan komputer -> langsung ke menu anak. Lewati dengan kidsos=off di GRUB.
# Jika tampilan gagal 3x berturut-turut, berhenti mencoba & tampilkan petunjuk
# (daripada mengulang diam-diam sehingga layar terlihat macet).
if [ -z "\${DISPLAY:-}" ] && [ "\$(tty)" = /dev/tty1 ] && ! grep -qw kidsos=off /proc/cmdline; then
    fails=/tmp/kidsos-x-fails
    n=\$(cat "\$fails" 2>/dev/null || echo 0)
    if [ "\$n" -lt 3 ]; then
        started=\$(date +%s)
        startx >"\$HOME/.kidsos-xsession.log" 2>&1
        if [ \$(( \$(date +%s) - started )) -lt 60 ]; then
            echo \$((n + 1)) > "\$fails"
        else
            echo 0 > "\$fails"
        fi
        exit      # login otomatis lagi -> coba lagi
    fi
    clear
    echo
    echo "  KidsOS: tampilan menu anak gagal dimulai (3x)."
    echo
    echo "  Admin: tekan Ctrl+Alt+F2, login dengan akun admin, lalu jalankan:"
    echo "      sudo kidsos-setup log"
    echo
    exec sleep 2147483647
fi
$MARK_END
EOF

    mkdir -p "$home/BukuCerita" "$home/.config/kidsos"
    chown -R "$KID_USER:" "$home/.xinitrc" "$bp" "$home/BukuCerita" "$home/.config"
}

setup_autologin() {
    local init; init=$(init_system)
    say "Login otomatis '$KID_USER' di tty1 ($init)..."
    case "$init" in
        sysvinit)
            [ -f "$CONF_DIR/inittab.orig" ] || cp -a /etc/inittab "$CONF_DIR/inittab.orig"
            sed -i -E "s|^1:([0-9]+):respawn:.*|1:\1:respawn:/sbin/getty --autologin $KID_USER --noclear 38400 tty1|" /etc/inittab
            telinit q 2>/dev/null || true
            ;;
        runit)
            local run=/etc/sv/getty-tty1/run
            [ -f "$run" ] || die "tidak menemukan $run"
            [ -f "$CONF_DIR/getty-tty1.run.orig" ] || cp -a "$run" "$CONF_DIR/getty-tty1.run.orig"
            printf '#!/bin/sh\nexec /sbin/agetty --autologin %s --noclear 38400 tty1 linux\n' \
                "$KID_USER" > "$run"
            chmod 755 "$run"
            ;;
        systemd)
            mkdir -p /etc/systemd/system/getty@tty1.service.d
            cat > /etc/systemd/system/getty@tty1.service.d/kidsos.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $KID_USER --noclear %I \$TERM
EOF
            systemctl daemon-reload
            ;;
        *) die "sistem init tidak dikenali; atur login otomatis tty1 secara manual" ;;
    esac
}

disable_display_managers() {
    local init dm link sd; init=$(init_system)
    touch "$DM_STATE"
    case "$init" in
        sysvinit)
            for dm in $DMS; do
                if [ -x "/etc/init.d/$dm" ] && ls /etc/rc[2-5].d/S*"$dm" >/dev/null 2>&1; then
                    say "Mematikan display manager: $dm"
                    update-rc.d "$dm" disable >/dev/null 2>&1 || true
                    echo "sysv $dm" >> "$DM_STATE"
                fi
            done
            ;;
        runit)
            for sd in /etc/service /etc/runit/runsvdir/default /var/service; do
                for dm in $DMS; do
                    link="$sd/$dm"
                    if [ -L "$link" ]; then
                        say "Mematikan display manager: $dm"
                        echo "runit $link $(readlink "$link")" >> "$DM_STATE"
                        rm -f "$link"
                    fi
                done
            done
            ;;
        systemd)
            link=/etc/systemd/system/display-manager.service
            if [ -L "$link" ]; then
                dm=$(basename "$(readlink -f "$link")")
                say "Mematikan display manager: $dm"
                systemctl disable "$dm" >/dev/null 2>&1 || true
                echo "systemd $dm" >> "$DM_STATE"
            fi
            ;;
    esac
    return 0
}

setup_xorg() {
    mkdir -p "$(dirname "$XORG_CONF")"
    cat > "$XORG_CONF" <<'EOF'
# KidsOS: anak tidak bisa pindah ke konsol teks atau mematikan X.
Section "ServerFlags"
    Option "DontVTSwitch" "true"
    Option "DontZap"      "true"
EndSection
EOF
}

setup_sudoers() {
    local cmds="" c path tmp
    for c in poweroff reboot; do
        for path in /sbin/$c /usr/sbin/$c; do
            [ -e "$path" ] && cmds="$cmds${cmds:+, }$path"
        done
    done
    cmds="$cmds${cmds:+, }$PKG_HELPER"
    tmp=$(mktemp)
    printf '# KidsOS: tombol Matikan/Mulai Ulang & pasang aplikasi menu\n%s ALL=(root) NOPASSWD: %s\n' \
        "$KID_USER" "$cmds" > "$tmp"
    visudo -cqf "$tmp" || { rm -f "$tmp"; die "sudoers tidak valid"; }
    install -m 440 "$tmp" "$SUDOERS"
    rm -f "$tmp"
}

setup_sounds() {
    say "Membuat suara & musik (sekali saja, bisa ±1 menit)..."
    if ! python3 "$INSTALL_DIR/sounds.py" --generate "$INSTALL_DIR/sounds" >/dev/null; then
        warn "gagal membuat suara; akan dibuat otomatis saat pertama dipakai"
    fi
}

setup_grub() {
    if [ ! -f /etc/default/grub ] || ! command -v update-grub >/dev/null 2>&1; then
        warn "GRUB tidak ditemukan; tema menu boot dilewati"
        return 0
    fi
    say "Memasang tema menu boot (GRUB)..."
    rm -rf "$GRUB_THEME_DIR"
    mkdir -p "$GRUB_THEME_DIR"
    cp "$ASSETS"/grub/* "$GRUB_THEME_DIR"/

    # Resolusi menu boot mengikuti RESOLUTION; ukuran huruf tema diskalakan
    # dari desain 1080p agar tetap muat di layar kecil (mis. 640x480).
    local gfx=auto h=1080 t i sm ih pad sp
    if [ "$RESOLUTION" != auto ]; then
        gfx="$RESOLUTION,auto"
        h=${RESOLUTION#*x}
    fi
    t=$(( 28 * h / 1080 ));   [ "$t" -lt 12 ] && t=12
    i=$(( 22 * h / 1080 ));   [ "$i" -lt 11 ] && i=11
    sm=$(( 18 * h / 1080 ));  [ "$sm" -lt 10 ] && sm=10
    ih=$(( 42 * h / 1080 ));  [ "$ih" -lt 22 ] && ih=22
    pad=$(( 14 * h / 1080 )); [ "$pad" -lt 6 ] && pad=6
    sp=$(( 8 * h / 1080 ));   [ "$sp" -lt 3 ] && sp=3
    sed -i -e "s/DejaVu Sans Bold 28/DejaVu Sans Bold $t/" \
           -e "s/DejaVu Sans Bold 22/DejaVu Sans Bold $i/g" \
           -e "s/DejaVu Sans Bold 18/DejaVu Sans Bold $sm/" \
           -e "s/item_height = 42/item_height = $ih/" \
           -e "s/item_padding = 14/item_padding = $pad/" \
           -e "s/item_spacing = 8/item_spacing = $sp/" "$GRUB_THEME_DIR/theme.txt"
    local font=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf sz
    if command -v grub-mkfont >/dev/null 2>&1 && [ -f "$font" ]; then
        for sz in $(printf '%s\n' "$t" "$i" "$sm" | sort -u); do
            grub-mkfont -s "$sz" -o "$GRUB_THEME_DIR/dejavu-bold-$sz.pf2" "$font" \
                >/dev/null 2>&1 || true
        done
    fi
    sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" /etc/default/grub
    cat >> /etc/default/grub <<EOF
$MARK_BEGIN
# Tema menu boot KidsOS (dihapus oleh: kidsos-setup disable)
GRUB_THEME="$GRUB_THEME_DIR/theme.txt"
GRUB_BACKGROUND=""
GRUB_DISTRIBUTOR="KidsOS"
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
unset GRUB_TERMINAL
GRUB_TERMINAL_OUTPUT=gfxterm
GRUB_GFXMODE=$gfx
GRUB_CMDLINE_LINUX_DEFAULT="\$GRUB_CMDLINE_LINUX_DEFAULT quiet"
$MARK_END
EOF
    update-grub >/dev/null 2>&1 || warn "update-grub gagal; periksa /etc/default/grub"
}

setup_bootanim() {
    if [ ! -r /sys/class/graphics/fb0/virtual_size ]; then
        warn "framebuffer tidak tersedia; animasi boot dilewati"
        return 0
    fi
    say "Menyiapkan animasi boot..."
    if ! python3 "$BOOTANIM" --prepare "$ASSETS/boot1.gif"; then
        warn "gagal menyiapkan animasi boot"
        return 0
    fi
    case "$(init_system)" in
        sysvinit)
            cat > "$BOOTANIM_INIT" <<'EOF'
#!/bin/sh
### BEGIN INIT INFO
# Provides:          kidsos-bootanim
# Required-Start:    mountkernfs $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Animasi boot KidsOS
### END INIT INFO
case "$1" in
    start) [ -x /usr/lib/kidsos/kidsos-bootanim ] && /usr/lib/kidsos/kidsos-bootanim >/dev/null 2>&1 & ;;
esac
exit 0
EOF
            chmod 755 "$BOOTANIM_INIT"
            update-rc.d kidsos-bootanim defaults >/dev/null 2>&1 || true
            ;;
        systemd)
            cat > "$BOOTANIM_UNIT" <<EOF
[Unit]
Description=Animasi boot KidsOS
DefaultDependencies=no
After=local-fs.target

[Service]
Type=simple
ExecStart=$BOOTANIM

[Install]
WantedBy=sysinit.target
EOF
            systemctl daemon-reload
            systemctl enable kidsos-bootanim.service >/dev/null 2>&1 || true
            ;;
        *) warn "animasi boot belum didukung untuk init ini (runit); dilewati" ;;
    esac
}

remove_boot() {
    if [ -f /etc/default/grub ] && grep -q "^$MARK_BEGIN\$" /etc/default/grub; then
        sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" /etc/default/grub
        update-grub >/dev/null 2>&1 || true
    fi
    rm -rf "$GRUB_THEME_DIR" /var/lib/kidsos/bootanim
    if [ -f "$BOOTANIM_INIT" ]; then
        update-rc.d -f kidsos-bootanim remove >/dev/null 2>&1 || true
        rm -f "$BOOTANIM_INIT"
    fi
    if [ -f "$BOOTANIM_UNIT" ]; then
        systemctl disable kidsos-bootanim.service >/dev/null 2>&1 || true
        rm -f "$BOOTANIM_UNIT"
        systemctl daemon-reload
    fi
}

cmd_boot() {
    setup_grub
    setup_bootanim
}

cmd_enable() {
    say "Mengaktifkan KidsOS (user anak: $KID_USER, admin: $ADMIN_USER)..."
    mkdir -p "$CONF_DIR"
    save_conf
    create_kid_user
    [ -s "$HASH_FILE" ] || set_password
    setup_kid_home
    setup_xorg
    setup_sudoers
    disable_display_managers
    setup_autologin
    setup_sounds
    cmd_boot
    touch "$CONF_DIR/enabled"
    say "Selesai! Nyalakan ulang komputer: sudo reboot"
    say "Darurat: di GRUB tekan 'e', tambahkan kidsos=off, lalu Ctrl+X."
}

# ------------------------------------------------------------------ disable
cmd_disable() {
    local init home bp kind a b; init=$(init_system)
    say "Menonaktifkan KidsOS..."

    case "$init" in
        sysvinit)
            if [ -f "$CONF_DIR/inittab.orig" ]; then
                a=$(grep -E '^1:[0-9]+:respawn:' "$CONF_DIR/inittab.orig" | head -n1)
                if [ -n "$a" ]; then
                    sed -i -E "s|^1:[0-9]+:respawn:.*|$a|" /etc/inittab
                fi
                telinit q 2>/dev/null || true
            fi
            ;;
        runit)
            if [ -f "$CONF_DIR/getty-tty1.run.orig" ]; then
                cp -a "$CONF_DIR/getty-tty1.run.orig" /etc/sv/getty-tty1/run
            fi
            ;;
        systemd)
            rm -rf /etc/systemd/system/getty@tty1.service.d/kidsos.conf
            systemctl daemon-reload
            ;;
    esac

    if [ -f "$DM_STATE" ]; then
        while read -r kind a b; do
            case "$kind" in
                sysv)    update-rc.d "$a" enable >/dev/null 2>&1 || true ;;
                runit)   ln -sf "$b" "$a" ;;
                systemd) systemctl enable "$a" >/dev/null 2>&1 || true ;;
            esac
        done < "$DM_STATE"
        rm -f "$DM_STATE"
    fi

    rm -f "$XORG_CONF" "$SUDOERS" "$CONF_DIR/enabled"
    remove_boot

    home=$(kid_home || true)
    if [ -n "$home" ] && [ -d "$home" ]; then
        bp="$home/.bash_profile"
        if [ -f "$bp" ]; then
            sed -i "/^$MARK_BEGIN\$/,/^$MARK_END\$/d" "$bp"
        fi
        if [ -f "$home/.xinitrc" ] && grep -q kidsos-session "$home/.xinitrc"; then
            rm -f "$home/.xinitrc"
            if [ -f "$home/.xinitrc.kidsos-bak" ]; then
                mv "$home/.xinitrc.kidsos-bak" "$home/.xinitrc"
            fi
        fi
    fi
    say "KidsOS nonaktif. User '$KID_USER' tidak dihapus (hapus: sudo deluser --remove-home $KID_USER)."
    say "Nyalakan ulang untuk kembali ke antiX biasa."
}

cmd_log() {
    local home dm f; home=$(kid_home || true)
    echo "== Log tampilan anak: $home/.kidsos-xsession.log (akhir) =="
    tail -n 40 "$home/.kidsos-xsession.log" 2>/dev/null || echo "(belum ada)"
    echo
    echo "== Error Xorg =="
    for f in "$home/.local/share/xorg/Xorg.0.log" /var/log/Xorg.0.log; do
        [ -f "$f" ] && { echo "-- $f"; grep -E '\(EE\)' "$f" | tail -n 15; }
    done
    echo
    echo "== Display manager yang masih berjalan (bentrok dengan KidsOS) =="
    for dm in $DMS; do
        if pgrep -x "$dm" >/dev/null 2>&1; then echo "  $dm MASIH BERJALAN"; fi
    done
    echo
    echo "== Login otomatis tty1 =="
    grep -E '^1:' /etc/inittab 2>/dev/null || true
    [ -f /etc/sv/getty-tty1/run ] && cat /etc/sv/getty-tty1/run
    echo
    echo "== Percobaan gagal sejak boot: $(cat /tmp/kidsos-x-fails 2>/dev/null || echo 0) =="
    echo
    cmd_status
}

cmd_status() {
    echo "Init system : $(init_system)"
    echo "User anak   : $KID_USER $(id "$KID_USER" >/dev/null 2>&1 && echo '(ada)' || echo '(belum ada)')"
    echo "Admin       : $ADMIN_USER"
    echo "Repository  : $REPO_URL ($REPO_BRANCH)"
    echo "Resolusi    : $RESOLUTION"
    echo "Password    : $([ -s "$HASH_FILE" ] && echo 'diatur' || echo 'BELUM (default admin123)')"
    echo "Status      : $([ -f "$CONF_DIR/enabled" ] && echo AKTIF || echo nonaktif)"
}

case "${1:-enable}" in
    enable)   cmd_enable ;;
    disable)  cmd_disable ;;
    password) set_password ;;
    status)   cmd_status ;;
    boot)     cmd_boot ;;
    log)      cmd_log ;;
    *) echo "Pemakaian: kidsos-setup {enable|disable|password|status|boot|log}" >&2; exit 2 ;;
esac
